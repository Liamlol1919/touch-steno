{
  "schema": "SCIENTIFIC-COMPARATOR-TEST-0",
  "version": 1,
  "synthetic_only": true,
  "hardware_validity": false,
  "claim_scope": "evidence-boundary validation only; no TSF, hardware, human, WPM, correction, or product evidence",
  "observation_boundary": {
    "fields": ["sequence_id", "frames.monotonic_time_ms", "frames.points"],
    "sensor_native_channels": ["x", "y", "pressure"],
    "points_are_unordered_within_frame": true,
    "excluded_before_decision": [
      "split",
      "session",
      "class",
      "null_flag",
      "nuisance",
      "expected_output",
      "ground_truth"
    ]
  },
  "classes": ["alpha", "beta", "gamma"],
  "fixture": {
    "frames_per_sequence": 5,
    "frame_interval_ms": 8,
    "positive_contact_count": 4,
    "train": {"sessions": 4, "positive_sequences_per_class_per_session": 3, "null_sequences_per_session": 2},
    "calibration": {"sessions": 3, "positive_sequences_per_class_per_session": 2, "null_sequences_per_session": 2},
    "test": {"sessions": 4, "positive_sequences_per_class_per_session": 3, "null_sequences_per_session": 2},
    "maximum_test_sequences": 48
  },
  "split_families": {
    "train": {
      "name": "polygonal_field_translation_A",
      "base_shape": "four-point convex polygon",
      "temporal_mechanism": "constant class-axis translation",
      "nuisance_transform": "bounded scale and translation jitter"
    },
    "calibration": {
      "name": "diamond_field_pulse_B",
      "base_shape": "four-point diamond",
      "temporal_mechanism": "eased axis-biased pulse",
      "nuisance_transform": "bounded radius, drift, and point jitter"
    },
    "test": {
      "name": "rectangular_field_twist_C",
      "base_shape": "four-point rectangle",
      "temporal_mechanism": "class-directed progress with alternating twist",
      "nuisance_transform": "bounded start offset and point jitter"
    },
    "shared_generation_function": false,
    "copied_prototypes": false
  },
  "control": {
    "name": "nearest_centroid",
    "uses_all_train_exemplars": true,
    "permutation_invariant_descriptor": true
  },
  "calibration": {
    "selects": ["acceptance_threshold"],
    "test_participates": false
  },
  "null_gate": {
    "maximum_false_commit_rate": 0.0,
    "requires_always_positive_control_failure": true
  },
  "confidence_interval": {
    "method": "deterministic_session_cluster_bootstrap",
    "replicates": 256,
    "seed": 20260925,
    "confidence": 0.95,
    "event_level_wilson_bounds": false
  },
  "integrity_fixtures": [
    "always_positive",
    "shuffled_label",
    "count_only",
    "path_length_nuisance_only",
    "point_order_permutation"
  ]
}
